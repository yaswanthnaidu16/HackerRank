class Solution:
    def canCompleteCircuit(self, A, B):
        total = 0
        tank = 0
        start = 0

        for i in range(len(A)):
            diff = A[i] - B[i]
            total += diff
            tank += diff

            if tank < 0:
                start = i + 1
                tank = 0

        if total < 0:
            return -1

        return start
